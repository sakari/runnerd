#!/usr/bin/env bash
# Runs gitleaks on staged changes to block commits that introduce secrets.
# Installed via the "prepare" script in package.json, which points
# core.hooksPath at this directory.
#
# Install gitleaks:
#   curl -sSL https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz \
#     | tar -xz -C ~/.local/bin gitleaks && chmod +x ~/.local/bin/gitleaks
# (see https://github.com/gitleaks/gitleaks for other platforms)
#
# Bypass (only when you're sure it's a false positive): git commit --no-verify
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found on PATH — skipping secret scan." >&2
  echo "pre-commit: install it so this hook can protect you:" >&2
  echo "  https://github.com/gitleaks/gitleaks#installing" >&2
  exit 0
fi

gitleaks git --staged --redact --verbose --no-banner
