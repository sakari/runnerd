{
  "expo": {
    "name": "runnerd",
    "slug": "runnerd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#123270"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.runnerd.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Runnerd uses your location to track distance during runs.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Runnerd uses your location in the background to keep tracking your run.",
        "UIBackgroundModes": ["location", "audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2864B4"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
