{
  "expo": {
    "name": "runnerd",
    "slug": "runnerd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#123270"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.runnerd.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Runnerd uses your location to measure the distance and pace of your run.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Runnerd continues tracking your distance and pace when the screen is locked or you switch to another app during a run.",
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2864B4"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.runnerd.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "./plugins/with-local-notifications-only",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/callouts/halfway.wav",
            "./assets/callouts/times_up.wav"
          ]
        }
      ]
    ]
  }
}
